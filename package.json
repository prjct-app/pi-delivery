{
  "name": "@prjct.app/pi-delivery",
  "version": "0.1.3",
  "description": "Track delivery criteria, evidence, reviews, and risks before completing substantial Pi tasks.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "delivery"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-delivery/main/docs/cover-v2.png"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-delivery.git"
  },
  "bugs": {
    "url": "https://github.com/prjct-app/pi-delivery/issues"
  },
  "homepage": "https://github.com/prjct-app/pi-delivery#readme",
  "files": [
    "index.ts",
    "state.ts",
    "render.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "export PI_CODING_AGENT_DIR=\"$(mktemp -d)\" PRJCT_HOME=\"$(mktemp -d)\" && node --import tsx --test --test-concurrency=1 state.test.ts render.test.ts",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "check": "tsc --noEmit",
    "build:pi": "node scripts/build-pi.mjs",
    "audit:runtime": "node scripts/audit-production.mjs"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "esbuild": "^0.28.1",
    "typebox": "1.3.7"
  }
}
